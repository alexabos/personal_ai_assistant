APP_NAME="Personal AI Assistant"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./assistant.db
LOG_LEVEL=INFO

# LLM (Phase 4). Leave LLM_API_KEY unset to fall back to the Anthropic SDK's
# own credential detection (ANTHROPIC_API_KEY env var or `ant auth login`).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOOL_ITERATIONS=4

# Google Calendar (Phase 5). See README for setup. These paths are gitignored
# - run scripts/google_calendar_auth.py once to create the token file.
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=credentials/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
DEFAULT_TIMEZONE=Europe/Madrid

# Notion (Phase 5.2). See README for setup. NOTION_API_KEY is a Notion
# internal integration token (non-interactive, no OAuth flow). Each
# NOTION_DATABASE_* line maps a logical source name to a database ID copied
# from that database's URL; add more by adding another field in
# config/settings.py plus a line here. Leave a source unset to disable it.
NOTION_API_KEY=
NOTION_DATABASE_UNIVERSITY=
NOTION_DATABASE_SANOFI=
NOTION_DATABASE_PERSONAL=
